{
  "name": "econt-client",
  "version": "0.1.0",
  "description": "TypeScript client for the Econt e-commerce shipping API (Bulgaria): waybills/labels, tracking, offices & settlements nomenclature, address completeness per the Bulgarian Postal Services Act.",
  "keywords": [
    "econt",
    "еконт",
    "shipping",
    "courier",
    "bulgaria",
    "e-commerce",
    "waybill",
    "label",
    "cod"
  ],
  "license": "MIT",
  "author": "Ivo Karabashev (https://github.com/frivolous-b)",
  "repository": {
    "type": "git",
    "url": "https://github.com/frivolous-b/econt-client.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/unit.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
